{
  "name": "football-data-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous football data platform: API-Football sync engine, PostgreSQL warehouse, Redis cache, derived statistics, prediction features, own API-key authenticated REST API, admin UI and website.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "tsx src/api/server.ts",
    "dev:worker": "tsx src/worker/worker.ts",
    "dev:scheduler": "tsx src/worker/scheduler.ts",
    "dev:web": "tsx src/web/server.ts",
    "database:migrate": "tsx src/cli/migrate.ts",
    "database:migrate:status": "tsx src/cli/migrate.ts --status",
    "competitions:import": "tsx src/cli/competitions-import.ts",
    "seasons:import": "tsx src/cli/seasons-import.ts",
    "historical:import": "tsx src/cli/historical-import.ts",
    "current:sync": "tsx src/cli/current-sync.ts",
    "competition:sync": "tsx src/cli/competition-sync.ts",
    "season:sync": "tsx src/cli/season-sync.ts",
    "fixture:sync": "tsx src/cli/fixture-sync.ts",
    "statistics:recalculate": "tsx src/cli/statistics-recalculate.ts",
    "team:recalculate": "tsx src/cli/team-recalculate.ts",
    "player:recalculate": "tsx src/cli/player-recalculate.ts",
    "referee:recalculate": "tsx src/cli/referee-recalculate.ts",
    "league:recalculate": "tsx src/cli/league-recalculate.ts",
    "prediction-features:rebuild": "tsx src/cli/prediction-features-rebuild.ts",
    "cache:rebuild": "tsx src/cli/cache-rebuild.ts",
    "data-quality:check": "tsx src/cli/data-quality.ts",
    "quota:status": "tsx src/cli/quota-status.ts",
    "sync:failed": "tsx src/cli/sync-failed.ts",
    "api-key:create": "tsx src/cli/api-key-create.ts",
    "api-key:rotate": "tsx src/cli/api-key-rotate.ts",
    "api-key:revoke": "tsx src/cli/api-key-revoke.ts",
    "api-key:list": "tsx src/cli/api-key-list.ts",
    "devdb:start": "tsx scripts/dev-db.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "bulk-finalize": "tsx scripts/bulk-finalize.ts"
  },
  "dependencies": {
    "argparse": "^3.0.2",
    "bullmq": "^6.3.8",
    "cron-parser": "^5.10.1",
    "express": "^4.22.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
