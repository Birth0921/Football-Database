{
  "name": "football-database",
  "version": "1.0.0",
  "description": "Autonomous football data platform: API-Football sync engine, PostgreSQL, Redis cache, own REST API with API-key auth, prediction features.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/api/server.js",
    "dev": "tsx src/api/server.ts",
    "worker": "tsx src/scheduler/worker.ts",
    "cli": "tsx src/cli/index.ts",
    "db:migrate": "tsx src/cli/index.ts database:migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "swagger": "tsx src/cli/index.ts swagger:export"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "bullmq": "^6.3.8",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
