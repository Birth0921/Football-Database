# ---------------------------------------------------------------------------
# Prediction app configuration — copy to .env and fill in.
# NEVER commit .env. NEVER put API_FOOTBALL_KEY (the provider key) in here.
# ---------------------------------------------------------------------------

# Your Football Data Platform API (the one this repo serves), e.g.
#   local:     http://localhost:4000/api/v1
#   deployed:  https://api.yourdomain.com/api/v1
FOOTBALL_API_BASE_URL=http://localhost:4000/api/v1

# Platform-issued key. Create with:
#   npm run api-key:create -- --client "Prediction App" \
#     --scopes "fixtures:read,teams:read,players:read,referees:read,standings:read,statistics:read,predictions:read"
FOOTBALL_API_KEY=pf_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Web UI
PORT=3000
HOST=0.0.0.0

# --- Training (optional) ----------------------------------------------------
# Read-only role from migration 0008_prediction_readonly_role.sql.
# Leave empty to run in feature-only mode (no training).
# TRAIN_DATABASE_URL=postgres://football_readonly:CHANGE_ME@127.0.0.1:5432/football

# --- Model tuning -----------------------------------------------------------
PREDICTION_MODEL_PATH=model/poisson-model.json
# 0 = trust platform features only, 1 = trust the trained model only
PREDICTION_TRAINED_WEIGHT=0.5
# how much of the attack estimate comes from expected goals (0…1)
PREDICTION_XG_WEIGHT=0.5
# how strongly home/away form splits adjust λ (0…1)
PREDICTION_VENUE_WEIGHT=0.35
# shrinkage constant: higher = team rates pulled harder to the league average
PREDICTION_SHRINKAGE_K=6
# parallel feature requests when scoring a batch
PREDICTION_CONCURRENCY=4
PREDICTION_DEFAULT_LIMIT=24
PREDICTION_MAX_GOALS=10
