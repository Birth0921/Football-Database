{
  "name": "football-prediction-app-example",
  "version": "1.0.0",
  "private": true,
  "description": "Reference prediction app for the Football Data Platform: reads prediction features over the REST API with a pf_live_ key, optionally blends strengths trained on the read-only database.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "train": "tsx src/training/train.ts",
    "train:csv": "tsx src/training/train.ts --csv training-data.csv",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@football-data-platform/client": "file:../../sdk/typescript",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
