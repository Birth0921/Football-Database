# ===== Platform (our own API) =====
API_PORT=3000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
# Default per-client fallback rate limits
DEFAULT_RATE_LIMIT_PER_MINUTE=120
DEFAULT_RATE_LIMIT_PER_DAY=50000

# ===== Secrets =====
# Secret used to protect /admin routes (sent as Authorization: Bearer <token> or X-Admin-Token)
ADMIN_TOKEN=change-me-long-random-string
# Pepper used when hashing our platform API keys. If unset, derived from ADMIN_TOKEN.
# WARNING: rotating the pepper invalidates every previously issued platform API key.
API_KEY_PEPPER=
# Optional general-purpose secret (session signing etc.)
JWT_SECRET=

# ===== External provider =====
# NEVER expose this to clients. Backend-only.
API_FOOTBALL_KEY=
# Official direct host by default; switch to your RapidAPI host if your subscription is via RapidAPI
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Provider quota planning (actual values are corrected from /status + response headers)
PROVIDER_DAILY_LIMIT=75000
PROVIDER_MINUTE_LIMIT=500
PROVIDER_MAX_RPS=3

# ===== Datastores =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football
REDIS_URL=redis://localhost:6379

# ===== Import scope =====
# Comma separated API-Football league ids. Empty = curated default set of major competitions.
IMPORT_LEAGUE_IDS=
# How many completed previous seasons (plus current) to import. 3 = spec default.
IMPORT_PREVIOUS_SEASONS=3
# How many most recent seasons get per-fixture deep data (events/stats/lineups/player-stats).
# Deep data is the most quota-hungry part; earlier seasons still get fixtures+standings+teams.
HISTORICAL_DETAIL_SEASONS=2

# ===== Workers =====
# Inline (in-process) task execution for CLI imports even when no worker is running
SYNC_INLINE=true
WORKER_CONCURRENCY=4
LIVE_POLL_SECONDS=60
SCHEDULER_ENABLED=true
