# ---------------------------------------------------------------------------
# Football Data Platform — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Core services
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/football
# Neon (managed): use the DIRECT endpoint (no "-pooler.") for long-lived servers
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Upstash (managed): use the TLS scheme
# REDIS_URL=rediss://default:pass@xxx.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379
NODE_ENV=development

# API server (on PaaS: falls back to the platform's $PORT if API_PORT unset)
API_PORT=4000
API_HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:4000
# API_INTERNAL_URL=http://127.0.0.1:4000   # website→API proxy target when the
                                           # API runs on another host/service

# Website (admin + public frontend) served by our own server (PaaS: $PORT fallback)
WEB_PORT=8080

# Containers: ROLE=api|worker|scheduler|web|all (all = single-container deploy);
# SKIP_MIGRATE=1 disables automatic migrations on api/all startup.

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=change-me-32-bytes-minimum
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password

# External provider (API-Football). KEEP PRIVATE — backend only.
# Leave empty to run in MOCK provider mode (no real API-Football calls).
API_FOOTBALL_KEY=

# Quota management (API-Football plan limits)
PROVIDER_DAILY_QUOTA=75000
PROVIDER_MINUTE_LIMIT=300

# Sync tuning
HISTORICAL_SEASONS_BACK=3
SYNC_LIVE_INTERVAL_SECONDS=60
SYNC_UPCOMING_INTERVAL_SECONDS=900
SYNC_POSTMATCH_INTERVAL_SECONDS=300
SYNC_METADATA_INTERVAL_SECONDS=21600
# Worker task-sweep cadence; raise to 15–30 on metered Redis (e.g. Upstash)
WORKER_SWEEP_INTERVAL_SECONDS=5
REPLAY_FROM_RAW=true

# Optional: stable site key for anonymous website traffic (else auto-provisioned per boot)
# SITE_API_KEY=pf_live_xxxxxxxx
